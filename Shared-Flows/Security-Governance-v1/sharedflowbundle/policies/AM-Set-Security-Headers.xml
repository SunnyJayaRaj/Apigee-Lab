<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Set-Security-Headers">
    <DisplayName>AM Set Security Headers</DisplayName>
    <Set>
        <Headers>
            <Header name="Strict-Transport-Security">max-age=31536000; includeSubDomains</Header>
            <Header name="X-Frame-Options">DENY</Header>
            <Header name="X-Content-Type-Options">nosniff</Header>
        </Headers>
    </Set>
    <Remove>
        <Headers>
            <Header>Server</Header>
            <Header>X-Powered-By</Header>
        </Headers>
    </Remove>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
