<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false"
               continueOnError="false"
               enabled="true"
               name="AM-Set-Secret-Key">

    <DisplayName>Set JWT Secret Key (Demo)</DisplayName>

    <AssignVariable>
        <Name>private.jwt_secret_key</Name>
        <Value>DEMO_SECRET_KEY_CHANGE_ME</Value>
    </AssignVariable>

    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>

</AssignMessage>